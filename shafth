import csv
import math
import os
import sys


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def load_materials_csv(path: str) -> dict:
    mats = {}
    with open(path, "r", encoding="utf-8", newline="") as f:
        r = csv.DictReader(f)
        required = {"id", "Sy_MPa"}
        if r.fieldnames is None or not required.issubset(set(r.fieldnames)):
            raise ValueError("materials.csv must have columns: id,Sy_MPa")

        for row in r:
            mid = (row.get("id") or "").strip()
            if not mid:
                continue
            mats[mid] = row
    if not mats:
        raise ValueError("materials.csv has no rows")
    return mats


def main() -> int:
    if len(sys.argv) != 4:
        eprint("usage: shafth do_mm di_mm material_id  (cases: stdin CSV name,M_Nmm,T_Nmm)")
        return 2

    try:
        do = float(sys.argv[1])  # outer diameter
        di = float(sys.argv[2])  # inner diameter
    except ValueError:
        eprint("error: do_mm/di_mm must be numbers")
        return 2

    if do <= 0:
        eprint("error: do_mm must be > 0")
        return 2
    if di < 0:
        eprint("error: di_mm must be >= 0")
        return 2
    if di >= do:
        eprint("error: di_mm must be < do_mm")
        return 2

    material_id = sys.argv[3]

    here = os.path.dirname(os.path.abspath(__file__))
    mat_path = os.path.join(here, "materials.csv")
    try:
        mats = load_materials_csv(mat_path)
    except Exception as ex:
        eprint(f"error: failed to read materials.csv: {ex}")
        return 2

    if material_id not in mats:
        eprint(f"error: unknown material_id: {material_id}")
        return 2

    try:
        allow = float(mats[material_id]["Sy_MPa"])
    except Exception:
        eprint(f"error: Sy_MPa is invalid for material_id: {material_id}")
        return 2
    if allow <= 0:
        eprint(f"error: Sy_MPa must be > 0 for material_id: {material_id}")
        return 2

    # Hollow shaft:
    # Z = I/c, I = pi/64*(do^4 - di^4), c = do/2  => Z = pi/32*(do^4 - di^4)/do
    # tau_max = T*r/J, J = pi/32*(do^4 - di^4), r = do/2 => tau = 16*T*do/(pi*(do^4 - di^4))
    d4diff = (do ** 4) - (di ** 4)
    if d4diff <= 0:
        eprint("error: invalid diameters (do^4 - di^4 must be > 0)")
        return 2

    # Precompute denominators
    # sigma_b = 32*M*do/(pi*(do^4-di^4))
    # tau     = 16*T*do/(pi*(do^4-di^4))
    denom = math.pi * d4diff

    w = csv.writer(sys.stdout, lineterminator="\n")
    r = csv.reader(sys.stdin)

    ok = True
    line_no = 0
    for row in r:
        line_no += 1
        if not row:
            continue
        if row[0].lstrip().startswith("#"):
            continue
        if len(row) < 3:
            eprint(f"error: line {line_no}: expected name,M_Nmm,T_Nmm")
            ok = False
            continue

        name = row[0].strip()
        try:
            M = float(row[1])
            T = float(row[2])
        except ValueError:
            eprint(f"error: line {line_no}: M_Nmm/T_Nmm must be numbers")
            ok = False
            continue

        sigma_b = 32.0 * M * do / denom
        tau = 16.0 * T * do / denom
        sigma_vm = math.sqrt(sigma_b * sigma_b + 3.0 * tau * tau)
        sf = (allow / sigma_vm) if sigma_vm > 0 else float("inf")

        # ヘッダなし（毎回出るのが嫌、という要望対応）
        w.writerow([name, material_id, f"{do:.6g}", f"{di:.6g}",
                    f"{sigma_b:.6g}", f"{tau:.6g}", f"{sigma_vm:.6g}", f"{allow:.6g}", f"{sf:.6g}"])

    return 0 if ok else 2


if __name__ == "__main__":
    raise SystemExit(main())
